{
	"layer": "bottom",
	"position": "top",

	"modules-left": [
		"hyprland/workspaces",
		"hyprland/window"
	],

	"modules-right": [
        "tray",
		"hyprland/language",
        "memory",
        "cpu",
        "temperature",
		"network#speed",
		"network",
		"clock"
	],

	// Modules

	"clock": {
		"interval": 10,
		"format": "{:%a %d/%m %H:%M}",
		"tooltip": false
	},

	"cpu": {
		"interval": 1,
		"tooltip": false,
		"format": " {usage}%",
		"format-alt": " {load}",
		"states": {
			"warning": 70,
			"critical": 90
		}
	},

	"hyprland/language": {
		"format": "{}",
        "format-en": "US",
        "format-ru": "RU",
		"tooltip": false
	},

	"memory": {
		"interval": 5,
		"format": "󱉟 {used:0.1f}G",
		"states": {
			"warning": 70,
			"critical": 90
		},
		"tooltip": false
	},

	"network#speed": {
		"interval": 1,
        "format": "↓ {bandwidthDownBytes}",
		"tooltip": false
	},

	"network": {
		"interval": 1,
        "format": "↑ {bandwidthUpBytes}",
		"tooltip": false
	},

	"hyprland/mode": {
		"format": "{}",
		"tooltip": false
	},

	"hyprland/window": {
		"format": "{}",
		"tooltip": false
	},

	"hyprland/workspaces": {
		"disable-scroll-wraparound": true,
		"smooth-scrolling-threshold": 4,
		"enable-bar-scroll": true,
		"format": "{name}"
	},

	"temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
		"critical-threshold": 90,
		"interval": 1,
		"format": "{icon} {temperatureC}°C",
		"format-icons": [
			"",
			"",
			"",
			"",
			""
		],
		"tooltip": false
	},

	"tray": {
		"icon-size": 18
		//"spacing": 10
	},
}

